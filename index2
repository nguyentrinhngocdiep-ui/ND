  </div>

  <script>
    // ========== CANVAS STARFIELD ==========
    const canvas = document.getElementById('starfield');
    const ctx = canvas.getContext('2d');
    let w, h, stars = [];

    function resize() {
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    class Star {
      constructor() {
        this.reset(true);
      }
      reset(init = false) {
        this.x = Math.random() * w;
        this.y = Math.random() * h;
        this.size = Math.random() * 1.8 + 0.3;
        this.speed = Math.random() * 0.15 + 0.02;
        this.opacity = Math.random() * 0.6 + 0.2;
        this.twinkleSpeed = Math.random() * 0.02 + 0.005;
        this.twinkle = Math.random() * Math.PI * 2;
        if (!init) this.y = h + 10;
      }
      update() {
        this.y -= this.speed;
        this.twinkle += this.twinkleSpeed;
        if (this.y < -10) this.reset();
      }
      draw() {
        const alpha = this.opacity * (0.5 + 0.5 * Math.sin(this.twinkle));
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;
        ctx.fill();
        // glow
        if (this.size > 1.2) {
          ctx.beginPath();
          ctx.arc(this.x, this.y, this.size * 3, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(192, 132, 252, ${alpha * 0.15})`;
          ctx.fill();
        }
      }
    }

    for (let i = 0; i < 280; i++) {
      stars.push(new Star());
    }

    function animateStars() {
      ctx.clearRect(0, 0, w, h);
      stars.forEach(s => {
        s.update();
        s.draw();
      });
      requestAnimationFrame(animateStars);
    }
    animateStars();

    // ========== FLOATING 5-POINT STARS ==========
    const starLayer = document.getElementById('starLayer');
    const colors = ['#c084fc', '#f9a8d4', '#67e8f9', '#fde68a', '#a5b4fc', '#fbcfe8'];

    function createFloatingStar() {
      const star = document.createElement('div');
      star.className = 'star';
      const size = Math.random() * 18 + 10;
      star.style.width = size + 'px';
      star.style.height = size + 'px';
      star.style.left = Math.random() * 100 + '%';
      star.style.top = Math.random() * 100 + '%';
      star.style.background = colors[Math.floor(Math.random() * colors.length)];
      star.style.setProperty('--dur', (Math.random() * 4 + 3) + 's');
      star.style.animationDelay = (Math.random() * 5) + 's';
      starLayer.appendChild(star);

      // remove after some time to prevent too many
      setTimeout(() => star.remove(), 12000);
    }

    // initial burst
    for (let i = 0; i < 25; i++) {
      setTimeout(createFloatingStar, i * 200);
    }
    // continuous
    setInterval(createFloatingStar, 800);

    // ========== SHOOTING STARS ==========
    function createShootingStar() {
      const s = document.createElement('div');
      s.className = 'shooting-star';
      const startX = Math.random() * window.innerWidth * 0.8;
      const startY = Math.random() * window.innerHeight * 0.4;
      s.style.left = startX + 'px';
      s.style.top = startY + 'px';
      document.body.appendChild(s);

      const angle = Math.PI / 4 + (Math.random() - 0.5) * 0.4;
      const distance = 300 + Math.random() * 400;
      const duration = 800 + Math.random() * 600;

      s.animate([
        { opacity: 0, transform: 'translate(0, 0) scale(0.5)' },
        { opacity: 1, transform: `translate(${distance * 0.3 * Math.cos(angle)}px, ${distance * 0.3 * Math.sin(angle)}px) scale(1)`, offset: 0.15 },
        { opacity: 0, transform: `translate(${distance * Math.cos(angle)}px, ${distance * Math.sin(angle)}px) scale(0.3)` }
      ], {
        duration: duration,
        easing: 'ease-out'
      }).onfinish = () => s.remove();
    }

    setInterval(createShootingStar, 2200);
    // a few at start
    setTimeout(createShootingStar, 500);
    setTimeout(createShootingStar, 1500);
  </script>
</body>
