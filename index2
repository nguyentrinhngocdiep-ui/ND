<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nguyễn Trịnh Ngọc Diệp | Cosmic Profile</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Quicksand:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg-deep: #05010f;
      --bg-mid: #0b0620;
      --accent: #c084fc;
      --accent-soft: #e9d5ff;
      --gold: #fde68a;
      --pink: #f9a8d4;
      --cyan: #67e8f9;
      --text: #f5f3ff;
      --card: rgba(15, 10, 40, 0.55);
      --border: rgba(192, 132, 252, 0.25);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Quicksand', sans-serif;
      background: var(--bg-deep);
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
      line-height: 1.6;
    }

    /* ===== CANVAS STARFIELD ===== */
    #starfield {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }

    /* ===== NEBULA OVERLAY ===== */
    .nebula {
      position: fixed;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background:
        radial-gradient(ellipse 80% 50% at 20% 30%, rgba(139, 92, 246, 0.18), transparent 60%),
        radial-gradient(ellipse 60% 40% at 80% 20%, rgba(236, 72, 153, 0.12), transparent 55%),
        radial-gradient(ellipse 70% 50% at 50% 80%, rgba(56, 189, 248, 0.1), transparent 50%),
        radial-gradient(ellipse 50% 30% at 70% 60%, rgba(251, 191, 36, 0.06), transparent 45%);
      animation: nebulaPulse 12s ease-in-out infinite alternate;
    }

    @keyframes nebulaPulse {
      0% { opacity: 0.7; filter: hue-rotate(0deg); }
      100% { opacity: 1; filter: hue-rotate(25deg); }
    }

    /* ===== FLOATING 5-POINT STARS ===== */
    .star-layer {
      position: fixed;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      overflow: hidden;
    }

    .star {
      position: absolute;
      width: 20px;
      height: 20px;
      background: transparent;
      clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
      animation: twinkle var(--dur) ease-in-out infinite;
      opacity: 0;
    }

    .star::before {
      content: '';
      position: absolute;
      inset: -4px;
      background: inherit;
      clip-path: inherit;
      filter: blur(6px);
      opacity: 0.7;
    }

    @keyframes twinkle {
      0%, 100% { opacity: 0; transform: scale(0.4) rotate(0deg); }
      50% { opacity: 1; transform: scale(1.1) rotate(15deg); }
    }

    /* ===== SHOOTING STARS ===== */
    .shooting-star {
      position: fixed;
      width: 4px;
      height: 4px;
      background: white;
      border-radius: 50%;
      box-shadow: 0 0 10px 2px rgba(255,255,255,0.8), 0 0 20px 4px rgba(192,132,252,0.4);
      z-index: 3;
      pointer-events: none;
      opacity: 0;
    }

    .shooting-star::after {
      content: '';
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 80px;
      height: 2px;
      background: linear-gradient(90deg, rgba(255,255,255,0.9), transparent);
      border-radius: 2px;
    }

    /* ===== MAIN CONTENT ===== */
    .content {
      position: relative;
      z-index: 10;
      max-width: 1100px;
      margin: 0 auto;
      padding: 40px 20px 80px;
    }

    /* ===== HERO ===== */
    .hero {
      text-align: center;
      padding: 60px 20px 40px;
      position: relative;
    }

    .avatar-wrap {
      width: 160px;
      height: 160px;
      margin: 0 auto 28px;
      position: relative;
    }

    .avatar {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: linear-gradient(135deg, #7c3aed, #ec4899, #06b6d4);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Orbitron', sans-serif;
      font-size: 3.2rem;
      font-weight: 800;
      color: white;
      box-shadow:
        0 0 30px rgba(192, 132, 252, 0.5),
        0 0 60px rgba(236, 72, 153, 0.3),
        inset 0 0 20px rgba(255,255,255,0.15);
      position: relative;
      z-index: 2;
      animation: avatarGlow 4s ease-in-out infinite alternate;
    }

    @keyframes avatarGlow {
      0% { box-shadow: 0 0 30px rgba(192,132,252,0.5), 0 0 60px rgba(236,72,153,0.3); }
      100% { box-shadow: 0 0 50px rgba(192,132,252,0.8), 0 0 90px rgba(236,72,153,0.5), 0 0 120px rgba(6,182,212,0.3); }
    }

    .avatar-ring {
      position: absolute;
      inset: -12px;
      border-radius: 50%;
      border: 2px solid transparent;
      background: linear-gradient(var(--bg-deep), var(--bg-deep)) padding-box,
                  linear-gradient(135deg, #a78bfa, #f472b6, #22d3ee, #a78bfa) border-box;
      animation: spin 8s linear infinite;
      z-index: 1;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .name {
      font-family: 'Orbitron', sans-serif;
      font-size: clamp(1.8rem, 5vw, 2.8rem);
      font-weight: 800;
      letter-spacing: 1px;
      background: linear-gradient(90deg, #e9d5ff, #f9a8d4, #67e8f9, #fde68a);
      background-size: 300% 100%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: gradientShift 6s ease infinite;
      margin-bottom: 8px;
    }

    @keyframes gradientShift {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }

    .subtitle {
      font-size: 1.05rem;
      color: var(--accent-soft);
      opacity: 0.85;
      margin-bottom: 6px;
    }

    .birthday {
      font-size: 0.95rem;
      color: var(--gold);
      letter-spacing: 1px;
    }

    .location {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 12px;
      padding: 6px 16px;
      background: rgba(192, 132, 252, 0.12);
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 0.9rem;
      color: var(--accent-soft);
    }

    /* ===== CARDS ===== */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 24px;
      margin-top: 48px;
    }

    .card {
      background: var(--card);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 28px 26px;
      position: relative;
      overflow: hidden;
      transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
    }

    .card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, #a78bfa, #f472b6, #22d3ee);
      opacity: 0.8;
    }

    .card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 40px rgba(124, 58, 237, 0.25);
      border-color: rgba(192, 132, 252, 0.5);
    }

    .card-title {
      font-family: 'Orbitron', sans-serif;
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--accent-soft);
    }

    .card-title .icon {
      font-size: 1.4rem;
    }

    /* Skills */
    .skills {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .skill-tag {
      padding: 8px 16px;
      background: linear-gradient(135deg, rgba(124, 58, 237, 0.25), rgba(236, 72, 153, 0.2));
      border: 1px solid rgba(192, 132, 252, 0.35);
      border-radius: 999px;
      font-size: 0.92rem;
      font-weight: 500;
      transition: all 0.3s ease;
      cursor: default;
    }

    .skill-tag:hover {
      background: linear-gradient(135deg, rgba(124, 58, 237, 0.45), rgba(236, 72, 153, 0.35));
      transform: scale(1.05);
      box-shadow: 0 0 15px rgba(192, 132, 252, 0.4);
    }

    /* Hobbies */
    .money-text {
      font-family: 'Orbitron', sans-serif;
      font-size: 1.6rem;
      font-weight: 800;
      letter-spacing: 3px;
      text-align: center;
      background: linear-gradient(90deg, #fde68a, #fbbf24, #f59e0b, #fde68a);
      background-size: 200% 100%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: moneyShine 3s linear infinite;
      text-shadow: 0 0 30px rgba(251, 191, 36, 0.3);
    }

    @keyframes moneyShine {
      0% { background-position: 0% 50%; }
      100% { background-position: 200% 50%; }
    }

    .money-note {
      text-align: center;
      margin-top: 10px;
      font-size: 0.9rem;
      color: rgba(253, 230, 138, 0.7);
      font-style: italic;
    }

    /* Goals */
    .goal-item {
      display: flex;
      gap: 14px;
      margin-bottom: 18px;
      align-items: flex-start;
    }

    .goal-item:last-child {
      margin-bottom: 0;
    }

    .goal-badge {
      flex-shrink: 0;
      width: 42px;
      height: 42px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      background: linear-gradient(135deg, rgba(124, 58, 237, 0.3), rgba(6, 182, 212, 0.25));
      border: 1px solid rgba(192, 132, 252, 0.3);
    }

    .goal-label {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--cyan);
      margin-bottom: 2px;
    }

    .goal-value {
      font-weight: 600;
      font-size: 1.05rem;
    }

    /* Contact */
    .contact-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .contact-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      background: rgba(255,255,255,0.03);
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,0.05);
      transition: all 0.3s ease;
      text-decoration: none;
      color: inherit;
    }

    .contact-item:hover {
      background: rgba(192, 132, 252, 0.12);
      border-color: rgba(192, 132, 252, 0.3);
      transform: translateX(6px);
    }

    .contact-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      background: linear-gradient(135deg, rgba(124, 58, 237, 0.35), rgba(236, 72, 153, 0.25));
      flex-shrink: 0;
    }

    .contact-info {
      flex: 1;
      min-width: 0;
    }

    .contact-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: rgba(233, 213, 255, 0.6);
      margin-bottom: 1px;
    }

    .contact-value {
      font-size: 0.95rem;
      font-weight: 500;
      word-break: break-all;
    }

    /* Full width card */
    .full {
      grid-column: 1 / -1;
    }

    /* Footer */
    .footer {
      text-align: center;
      margin-top: 60px;
      padding: 24px;
      font-size: 0.85rem;
      color: rgba(233, 213, 255, 0.45);
      letter-spacing: 1px;
    }

    .footer span {
      color: var(--accent);
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 600px) {
      .hero { padding: 40px 10px 20px; }
      .avatar-wrap { width: 130px; height: 130px; }
      .avatar { font-size: 2.5rem; }
      .card { padding: 22px 18px; }
      .money-text { font-size: 1.3rem; letter-spacing: 2px; }
    }
  </style>
</head>
<body>
